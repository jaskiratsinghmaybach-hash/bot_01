# ---------------------------------------------------------------------------
# BOT_01 environment configuration
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See docs/security.md before using LIVE mode.
# ---------------------------------------------------------------------------

# Postgres connection string (required).
# Local example: postgres://postgres:postgres@localhost:5432/bot_01
DATABASE_URL=

# Trading pair (default: SOLUSDC)
SYMBOL=SOLUSDC

# Execution mode: dry-run | paper | live
#   dry-run — strategy evaluates candles and logs signals, no orders of any kind
#   paper   — simulated fills against real Binance prices, with fees/slippage,
#             recorded to Postgres with PAPER provenance. No exchange calls.
#   live    — real signed orders sent to Binance. Requires the credentials below
#             AND I_HAVE_TESTED_LIVE_EXECUTION=true (see below).
# Defaults to dry-run if unset — LIVE is never the default.
TRADING_MODE=dry-run

# Binance API credentials — required ONLY when TRADING_MODE=live.
# Use a key with SPOT TRADING permission only. Withdrawal permission must be
# disabled. See docs/security.md.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Extra confirmation gate for live trading. The app refuses to boot under
# TRADING_MODE=live unless this is explicitly set to "true" — a deliberate
# extra step so going live is never accidental. See docs/execution.md.
I_HAVE_TESTED_LIVE_EXECUTION=false

# Binance signed-request recvWindow in milliseconds. Used only in live mode.
RECV_WINDOW_MS=5000

# Risk model: fixed-usd | percent-balance
#   fixed-usd        — risk RISK_PER_TRADE_USD dollars per trade, regardless
#                       of account balance.
#   percent-balance  — risk RISK_PERCENT_OF_BALANCE of the live account
#                       balance per trade. Only meaningful with TRADING_MODE=live
#                       (fetches a real balance from Binance); paper/dry-run
#                       always use fixed-usd regardless of this setting.
RISK_MODEL=fixed-usd
RISK_PER_TRADE_USD=25
RISK_PERCENT_OF_BALANCE=0.02

# Hard notional ceiling in USD, enforced independently of risk-based sizing.
MAX_POSITION_USD=500

# Fraction of live account balance treated as an absolute affordability
# ceiling under RISK_MODEL=percent-balance (e.g. 0.98 = never use more than
# 98% of balance for a single position, regardless of risk math).
MAX_BALANCE_FRACTION=0.98

# Paper-trading simulation parameters (ignored outside TRADING_MODE=paper)
PAPER_STARTING_BALANCE_USD=1000
PAPER_SLIPPAGE_FRACTION=0.0005
PAPER_FEE_FRACTION=0.001

# debug | info | warn | error
LOG_LEVEL=info
