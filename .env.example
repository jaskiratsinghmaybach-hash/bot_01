# ---------------------------------------------------------------------------
# BOT_01 environment configuration
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See docs/security.md before using LIVE mode.
# ---------------------------------------------------------------------------

# Postgres connection string (required).
# Local example: postgres://postgres:postgres@localhost:5432/bot_01
DATABASE_URL=

# Trading pair (default: SOLUSDC)
SYMBOL=SOLUSDC

# Execution mode: dry-run | paper | live
#   dry-run — strategy evaluates candles and logs signals, no orders of any kind
#   paper   — simulated fills against real Binance prices, with fees/slippage,
#             recorded to Postgres with PAPER provenance. No exchange calls.
#   live    — real signed orders sent to Binance. Requires the credentials below.
# Defaults to dry-run if unset — LIVE is never the default.
TRADING_MODE=dry-run

# Binance API credentials — required ONLY when TRADING_MODE=live.
# Use a key with SPOT TRADING permission only. Withdrawal permission must be
# disabled. See docs/security.md.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Risk engine
RISK_PER_TRADE_USD=25
MAX_POSITION_USD=500

# Paper-trading simulation parameters (ignored outside TRADING_MODE=paper)
PAPER_STARTING_BALANCE_USD=1000
PAPER_SLIPPAGE_FRACTION=0.0005
PAPER_FEE_FRACTION=0.001

# debug | info | warn | error
LOG_LEVEL=info
