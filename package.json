{
  "name": "bot_01",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "description": "BOT_01 — Binance market-data pipeline, strategy engine, risk engine, and paper/live execution framework for SOLUSDC swing trading.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/main.ts",
    "start": "node dist/main.js",
    "verify": "node --loader ts-node/esm src/scripts/verify-strategy.ts",
    "backtest": "node --loader ts-node/esm src/scripts/run-backtest.ts",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts",
    "test:build": "tsc -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "keywords": [
    "binance",
    "crypto",
    "trading-bot",
    "algorithmic-trading",
    "typescript"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
